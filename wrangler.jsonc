{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The hosted version at stub.vedantagrw.com, deployed with `npm run deploy`.
	// The Cloudflare account comes from CLOUDFLARE_ACCOUNT_ID, so it isn't written here.
	"name": "stub",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "stub.vedantagrw.com", "custom_domain": true }],
	// One public address only
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },

	// Cloudflare's headless Chrome, for PNG, JPEG and PDF from the API
	"browser": { "binding": "BROWSER" },
	// API key hashes and daily counters
	"kv_namespaces": [{ "binding": "STUB_KV", "id": "da3b90b324194ce39d8a209b886be924" }],
	"ratelimits": [
		{ "name": "KEY_LIMITER", "namespace_id": "4721", "simple": { "limit": 30, "period": 60 } },
		{ "name": "IP_LIMITER", "namespace_id": "4722", "simple": { "limit": 10, "period": 60 } }
	],
	"vars": {
		// Public by design: Turnstile site keys are meant to be in the page
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFrsIQFNqoB8rnUP",
		"TURNSTILE_HOSTNAMES": "stub.vedantagrw.com"
	}
	// Secret, not in this file: TURNSTILE_SECRET (wrangler secret put TURNSTILE_SECRET)
}
