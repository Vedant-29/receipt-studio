{
	"$schema": "node_modules/wrangler/config-schema.json",
	// stub.vedantagrw.com. Deployed from a machine with `npm run deploy`; the GitHub repo
	// doesn't deploy anything. The Cloudflare account comes from CLOUDFLARE_ACCOUNT_ID.
	"name": "stub",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "stub.vedantagrw.com", "custom_domain": true }],
	// One public address only
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },

	// First-line dampers, per Cloudflare location (approximate). The exact API quotas are
	// counted in Postgres (supabase/migrations).
	"ratelimits": [
		// Signed-out traffic and API calls without a valid key, per IP
		{ "name": "IP_LIMITER", "namespace_id": "4722", "simple": { "limit": 30, "period": 60 } },
		// The app's own routes for a signed-in person (autosave, history, keys), per user
		{ "name": "USER_LIMITER", "namespace_id": "4723", "simple": { "limit": 120, "period": 60 } }
	]

	// Settings, not in this file: SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
	// Production: Worker secrets (wrangler secret put). Locally: .dev.vars, the same values.
}
