		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.156.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
