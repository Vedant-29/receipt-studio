{
	"name": "stub",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start": "node scripts/start.js",
		"dev": "vite dev",
		"build": "vite build",
		"build:cloud": "STUB_TARGET=cloudflare vite build",
		"preview:cloud": "STUB_TARGET=cloudflare vite build && wrangler dev",
		"deploy": "STUB_TARGET=cloudflare vite build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
